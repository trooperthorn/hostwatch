# Settings for hostwatch-control on Linux. Copy to /etc/hostwatch/control.env, owned by root with group
# hostwatch-control, mode 0640. Never commit a real key.
HOSTWATCH_CONTROL_URL=https://observe.example.lan:8443
# The wpc_ control key for this host, created in Observe and bound to this host name.
HOSTWATCH_CONTROL_KEY=
