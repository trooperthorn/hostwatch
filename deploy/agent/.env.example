# Copy to deploy/agent/.env, fill in and chmod 0600. Do not commit .env.

# Where the hub listens, using the hub's specific LAN address (never 127.0.0.1 here).
HOSTWATCH_HUB_URL=http://192.0.2.10:8090

# The ingest-only key created for this agent on the hub: python -m hostwatch key create
HOSTWATCH_INGEST_KEY=

# The name this host shows in the hub.
HOSTWATCH_HOST_NAME=ai-pi

# Group id that may read the host journal: getent group systemd-journal | cut -d: -f3
HOSTWATCH_JOURNAL_GID=

# Optional: the Raspberry Pi throttled bitmask file, if the default sysfs path is absent.
# HOSTWATCH_RPI_THROTTLED_PATH=

# Optional: the thermalctl fan controller status file, if it is not at /run/thermalctl/status.json.
# HOSTWATCH_THERMALCTL_STATUS=
