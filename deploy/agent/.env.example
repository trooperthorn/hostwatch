# Copy to deploy/agent/.env, fill in and chmod 0600. Do not commit .env.
#
# Boolean settings (HOSTWATCH_OTLP_GZIP, HOSTWATCH_TRUENAS_INSECURE) accept 1, true, yes, on as true
# and 0, false, no, off or empty as false, in any letter case. Any other value stops startup with an
# error naming the variable.

# The Observe base URL, without a path. HOSTWATCH_HUB_URL is accepted as an alias for it.
HOSTWATCH_OBSERVE_URL=https://observe.example.lan

# The ingest key created for this host in Observe. It is bound to the host name below.
HOSTWATCH_INGEST_KEY=

# The name this host has in Observe. It must match the host the key is bound to.
HOSTWATCH_HOST_NAME=ai-pi

# Group id that may read the host journal: getent group systemd-journal | cut -d: -f3
HOSTWATCH_JOURNAL_GID=

# Optional: the Raspberry Pi throttled bitmask file, if the default sysfs path is absent.
# HOSTWATCH_RPI_THROTTLED_PATH=

# Optional: the thermalctl fan controller status file, if it is not at /run/thermalctl/status.json.
# HOSTWATCH_THERMALCTL_STATUS=
