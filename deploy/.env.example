# Copy to deploy/.env and fill in. Do not commit .env.
#
# Boolean settings (HOSTWATCH_OTLP_GZIP, HOSTWATCH_TRUENAS_INSECURE) accept 1, true, yes, on as true
# and 0, false, no, off or empty as false, in any letter case.
# Any other value, such as "maybe", stops startup with an error naming the variable.

# The Observe base URL, without a path. HOSTWATCH_HUB_URL is accepted as an alias for it.
HOSTWATCH_OBSERVE_URL=https://observe.example.lan

# The ingest key created for this host in Observe. It is bound to the host name below.
HOSTWATCH_INGEST_KEY=

# The name this host has in Observe. It must match the host the key is bound to.
# HOSTWATCH_HOST_NAME=

# Group id that may read RAPL energy counters. Printed by scripts/rapl-access.sh
HOSTWATCH_RAPL_GID=

# Group id that may read the host journal. Required so the container user can
# open the journal files. Set it from: getent group systemd-journal | cut -d: -f3
HOSTWATCH_JOURNAL_GID=

# Scrutiny web/API base URL (host port as published by your Scrutiny container)
HOSTWATCH_SCRUTINY_URL=http://127.0.0.1:8081

# Optional hwmon tuning. HOSTWATCH_HWMON_IGNORE drops readings entirely (comma-separated chip:sensor
# globs, for example the unused Super I/O inputs on MediaIn-SVR). HOSTWATCH_HWMON_CPU_SENSORS marks
# extra chip:sensor readings as CPU temperatures so the CPU limits apply to them.
# HOSTWATCH_HWMON_IGNORE=nct6779:AUXTIN*,nct6779:PCH_*
# HOSTWATCH_HWMON_CPU_SENSORS=nct6779:CPUTIN

# How requests are encoded. protobuf (the default) is smaller; json is for debugging.
# HOSTWATCH_OTLP_FORMAT=protobuf
# HOSTWATCH_OTLP_GZIP=1

# The polling rates are not set here. Observe tells the agent its rates for each tier.

# Optional overrides (defaults shown). The event source paths are container
# paths that match the read-only mounts in docker-compose.yml.
# HOSTWATCH_JOURNAL=/host/journal
# HOSTWATCH_JOURNAL_VOLATILE=/host/journal-volatile
# HOSTWATCH_PSTORE=/host/pstore
# HOSTWATCH_RASDAEMON_DB=/host/rasdaemon/ras-mc_event.db
# NUT UPS client, off unless both the host and the UPS name are set. Read-only requests only.
# HOSTWATCH_NUT_HOST=
# HOSTWATCH_NUT_PORT=3493
# HOSTWATCH_NUT_UPS=
# HOSTWATCH_NUT_USER=
# HOSTWATCH_NUT_PASSWORD_FILE=
