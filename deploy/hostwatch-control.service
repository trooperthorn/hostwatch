# hostwatch-control: the per-host command daemon, separate from the read-only collector.
#
# It runs as its own unprivileged account and dials out to Observe only. It opens no port. Root-level
# work goes through the sudo rules in hostwatch-control.sudoers, which list the exact commands allowed.
# NoNewPrivileges is deliberately not set, because it would stop sudo from working.
#
# Install: see docs/deploy-agents.md. Create the account, the settings file and control.toml first.
[Unit]
Description=hostwatch control daemon
Documentation=https://github.com/trooperthorn/hostwatch
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/hostwatch/control.toml

[Service]
Type=simple
User=hostwatch-control
Group=hostwatch-control
# Holds HOSTWATCH_CONTROL_URL and HOSTWATCH_CONTROL_KEY. Owned by root, mode 0640, group hostwatch-control.
EnvironmentFile=/etc/hostwatch/control.env
ExecStart=/opt/hostwatch-control/venv/bin/python -m hostwatch control run
Restart=on-failure
RestartSec=10
# Replay state and the result outbox live here, and nothing else is writable.
StateDirectory=hostwatch-control
StateDirectoryMode=0700
Environment=HOSTWATCH_CONTROL_DATA_DIR=/var/lib/hostwatch-control
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
# Fan actions on thermalctl change /etc/thermalctl/overrides.toml, which thermalctl requires to be root
# owned. The daemon never writes it directly: it runs the exact tee, check-config, mv and rm commands in
# hostwatch-control.sudoers as root. ProtectSystem=strict makes /etc read-only for those root children
# too, so this one directory is made writable in the mount namespace. The directory stays root owned
# and mode 0755, so the unprivileged account still cannot write it. The leading dash lets the unit start
# on a host without thermalctl.
ReadWritePaths=-/etc/thermalctl

[Install]
WantedBy=multi-user.target
